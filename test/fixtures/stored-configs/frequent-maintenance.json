{
  "note": "a five-minute recurring maintenance window and 201 one-off windows, accepted before 0.3.9/0.3.10",
  "config": {
    "title": "Example Status",
    "baseUrl": "https://status.example.test",
    "timezone": "UTC",
    "admin": true,
    "access": {
      "provider": {
        "type": "basic"
      },
      "admins": {
        "emails": [
          "owner@example.test"
        ]
      }
    },
    "groups": [
      {
        "name": "Web",
        "monitors": [
          {
            "id": "site",
            "kind": "http",
            "name": "Site",
            "url": "https://www.example.test/health",
            "interval": "1m"
          },
          {
            "id": "nightly",
            "kind": "push",
            "name": "Nightly job",
            "schedule": "0 3 * * *",
            "grace": "30m"
          }
        ]
      }
    ],
    "maintenance": [
      {
        "title": "Rolling restart",
        "monitors": "*",
        "schedule": "*/5 * * * *",
        "duration": "1m"
      },
