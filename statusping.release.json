{
  "format": "statusping-template/v1",
  "release": "0.3.8",
  "template": "0.3.8",
  "channel": "stable",
  "source": {
    "repository": "https://github.com/getstatusping/statusping",
    "deployUrl": "https://deploy.workers.cloudflare.com/?url=https://github.com/getstatusping/statusping"
  },
  "ownership": {
    "updaterOwnedPaths": [
      ".github/",
      ".gitignore",
      "adapters/",
      "cli/",
      "packages/",
      "scripts/",
      "src/",
      "test/",
      "LICENSE",
      "MIGRATING-TO-YAML.md",
      "README.md",
      "package-lock.json",
      "package.json",
      "statusping.release.json",
      "statusping.schema.json",
      "tsconfig.json",
      "vitest.config.ts"
    ],
    "customerOwnedPaths": [
      ".dev.vars",
      "statusping.config.ts",
      "wrangler.toml"
    ],
    "optionalCustomerOwnedPaths": [
      ".dev.vars",
      "statusping.config.ts"
    ],
    "updaterOwnedWranglerBindings": [
      "STATUSPING_TEMPLATE_VERSION"
    ],
    "preservedRegions": {
      "README.md": {
        "start": "<!-- statusping:local-notes:start -->",
        "end": "<!-- statusping:local-notes:end -->"
      }
    }
  }
}
